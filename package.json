{
  "name": "xingbugudi-tavern",
  "version": "3.0.0",
  "description": "多 Agent 驱动的游戏 NPC 系统：场面调度 + 分层记忆 + 工具编排 + 反思复核 + 内容安全 + 评测与可观测",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "eval": "node eval/run.js",
    "eval:offline": "node eval/run.js --suite=intent,safety,retrieval,prompt",
    "eval:e2e": "node eval/run.js --suite=persona,e2e",
    "eval:multiagent": "node eval/run.js --suite=multiagent",
    "metrics": "node eval/metrics.js"
  },
  "keywords": [
    "llm",
    "agent",
    "multi-agent",
    "game-ai",
    "npc",
    "function-calling",
    "rag",
    "telemetry",
    "evals"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  }
}
