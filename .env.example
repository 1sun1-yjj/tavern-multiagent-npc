DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

DEEPSEEK_MODEL=deepseek-chat

PORT=3000

SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

SILICONFLOW_EMBED_MODEL=BAAI/bge-m3

# 观测：内存里保留多少条 trace；设为 1 会在服务端每轮打印一行摘要
TRACE_RING_SIZE=60
TRACE_VERBOSE=0

# 费率（元/百万 token）。默认只是占位，按官网实际价格改
PRICE_INPUT_PER_M=2
PRICE_OUTPUT_PER_M=8

# 稳定性
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=400
MAX_AGENT_LOOPS=6

# 多 Agent 调度
# 次要角色想插话的最低 urgency（0-1）。默认偏高：插话是例外，不是常态
REACT_THRESHOLD=0.55
# 同一拍最多允许几个次要角色开口
MAX_SECONDARY_SPEAKERS=1
# 次要角色插话后，隔几拍才允许再插
SECONDARY_COOLDOWN=2
# 补跑那次 react（听完主角回话后再决定要不要接）额外抬高的门槛
FOLLOWUP_EXTRA_BAR=0.15
# 导演每隔几拍调度一次
DIRECTOR_EVERY=3
# 看门狗：一次玩家输入最多允许的模型调用总数，超了立刻停
MAX_SCENE_CALLS=16

# 客人参与
# 主角说完后，补跑一次「听完对方回话」的 react（0 = 关，客人只能对玩家原话做反应）
GUEST_FOLLOWUP=1
# 客人主动找玩家搭话的总开关
GUEST_INITIATIVE=1
# 每次空闲检测命中时真的开口的概率（0-1）。调低更安静
GUEST_INITIATIVE_CHANCE=0.35
# 玩家安静多久之后，客人才考虑主动开口（毫秒）
GUEST_INITIATIVE_MIN_IDLE_MS=20000
# 两次主动搭话之间的最小间隔（毫秒）
GUEST_INITIATIVE_GAP_MS=45000
# 客人主动开口后，玩家不点名的回话在多久内算是对他说的（毫秒）
GUEST_REPLY_WINDOW_MS=90000

# 能力开关，设 0 关闭
SAFETY_ENABLED=1
REFLECTION_ENABLED=1
