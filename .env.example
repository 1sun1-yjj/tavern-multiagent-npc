DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

DEEPSEEK_MODEL=deepseek-chat

PORT=3000

SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

SILICONFLOW_EMBED_MODEL=BAAI/bge-m3

# ---------- 观测层 ----------
# 内存中保留的 trace 条数（观测台列表）
TRACE_RING_SIZE=60
# 设为 1 时每次对话在服务端打印一行 trace 摘要
TRACE_VERBOSE=0
# 费率（元 / 百万 token）——仅作示例，请以服务商官网最新价格为准
PRICE_INPUT_PER_M=2
PRICE_OUTPUT_PER_M=8

# ---------- 稳定性 ----------
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=400
MAX_AGENT_LOOPS=6

# ---------- 能力开关 ----------
# 内容安全与边界控制（0 = 关闭）
SAFETY_ENABLED=1
# 工具调用后的反思复核（0 = 关闭）
REFLECTION_ENABLED=1
